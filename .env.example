APP_NAME=Feetness
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# Local Docker (compose.yaml + compose.override.yaml)
#
#   make up          — start app + mysql + redis + mailpit
#   make test        — run Pest inside the container
#   make shell       — open a shell in the app container
#   make fresh       — migrate:fresh --seed
#
# API:  http://localhost:8088
# Mail: http://localhost:8025  (Mailpit dashboard)
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8088
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=work_it_out
DB_USERNAME=sail
DB_PASSWORD=password

REDIS_HOST=redis

# Msty local model (load Granite in Msty Studio first)
AI_DEFAULT_PROVIDER=openai
OPENAI_URL=http://host.docker.internal:11973/v1
OPENAI_API_KEY=msty-not-needed
AI_TEXT_MODEL=mlx-community/granite-3.3-2b-instruct-4bit

# ─────────────────────────────────────────────────────────────────────────────
# Production (Coolify / VPS)
# ─────────────────────────────────────────────────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# LOG_LEVEL=error
#
# DB_DATABASE=feetness
# DB_USERNAME=feetness
# DB_PASSWORD=
#
# AI_DEFAULT_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_TEXT_MODEL=gemini-3.5-flash
#
# Browser frontends (Nuxt) need their origin allowed; Flutter ignores CORS.
# CORS_ALLOWED_ORIGINS=https://app.your-domain.com

# Telegram bot from @BotFather. Run one poller: php artisan channel:telegram:poll
TELEGRAM_BOT_TOKEN=

# One model per job (optional). Empty = the default provider and AI_TEXT_MODEL.
# Log parsing must be cheap and reachable from the gym. Examples:
#   AI_LOG_PROVIDER=gemini    AI_LOG_MODEL=gemini-3.5-flash-lite
#   AI_LOG_PROVIDER=deepseek  AI_LOG_MODEL=deepseek-flash   (needs DEEPSEEK_API_KEY)
AI_LOG_PROVIDER=
AI_LOG_MODEL=
AI_PLAN_PROVIDER=
AI_PLAN_MODEL=
AI_CHAT_PROVIDER=
AI_CHAT_MODEL=
# DEEPSEEK_API_KEY=

# Classify step (what kind of message is this). llm = ClassifierAgent on the log
# job's model; laya = self-hosted typed-decision model (make laya); jev = TypeSafe hosted.
# Try them side by side: php artisan classify:try "..." or http://localhost:8088/lab/classify
AI_CLASSIFIER=llm
AI_CLASSIFIER_MIN_CONFIDENCE=0.6
AI_CLASSIFIER_FALLBACK=true
# From the Docker app container use http://host.docker.internal:8765
LAYA_URL=http://localhost:8765
# Empty routes by language; laya-typed-decisions scored best on tests/Evals/classify.txt (21/31)
LAYA_MODEL=laya-typed-decisions
TYPESAFE_API_KEY=
