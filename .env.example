APP_NAME=Feetness
APP_KEY=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

APP_TRAINER_DEFAULT_PERSONA=lt_surge

# ─────────────────────────────────────────────────────────────────────────────
# Local Docker (compose.yaml + compose.override.yaml)
#
#   make up          — start app + mysql + redis + mailpit
#   make test        — run Pest inside the container
#   make shell       — open a shell in the app container
#   make fresh       — migrate:fresh --seed
#
# API:  http://localhost:8088
# Mail: http://localhost:8025  (Mailpit dashboard)
# ─────────────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8088
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=work_it_out
DB_USERNAME=sail
DB_PASSWORD=password

REDIS_HOST=redis

# Msty local model (load Granite in Msty Studio first)
AI_DEFAULT_PROVIDER=openai
OPENAI_URL=http://host.docker.internal:11973/v1
OPENAI_API_KEY=msty-not-needed
AI_TEXT_MODEL=mlx-community/granite-3.3-2b-instruct-4bit

# ─────────────────────────────────────────────────────────────────────────────
# Production (Coolify / VPS)
# ─────────────────────────────────────────────────────────────────────────────
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# LOG_LEVEL=error
#
# DB_DATABASE=feetness
# DB_USERNAME=feetness
# DB_PASSWORD=
#
# AI_DEFAULT_PROVIDER=gemini
# GEMINI_API_KEY=
# AI_TEXT_MODEL=gemini-2.5-flash
#
# Browser frontends (Nuxt) need their origin allowed; Flutter ignores CORS.
# CORS_ALLOWED_ORIGINS=https://app.your-domain.com
