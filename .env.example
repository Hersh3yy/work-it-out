APP_NAME=Feetness
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=feetness
DB_USERNAME=feetness
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider
#
# Set AI_DEFAULT_PROVIDER to switch between local (openai-compatible Msty)
# and cloud (Gemini).
#
# PRODUCTION (Coolify / VPS):
#   AI_DEFAULT_PROVIDER=gemini
#   GEMINI_API_KEY=<your-google-ai-studio-auth-key>
#   AI_TEXT_MODEL=gemini-2.5-flash
#
#   To get an auth key:
#     1. Go to https://aistudio.google.com/apikey
#     2. Create API Key → select your project
#     3. Restrict the key to the "Generative Language API" service
#        (Coolify/VPS: optionally also restrict by your VPS IP)
#     4. Paste the key below.
#
# LOCAL (Msty + IBM Granite):
#   AI_DEFAULT_PROVIDER=openai
#   OPENAI_URL=http://host.docker.internal:11973/v1
#   OPENAI_API_KEY=msty-not-needed
#   AI_TEXT_MODEL=mlx-community/granite-3.3-2b-instruct-4bit
#   (load the Granite model in Msty Studio first)
# ─────────────────────────────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=gemini

# Gemini (production)
GEMINI_API_KEY=
AI_TEXT_MODEL=gemini-2.5-flash

# Msty / local model (development only — leave blank when using Gemini)
OPENAI_URL=http://host.docker.internal:11973/v1
OPENAI_API_KEY=msty-not-needed

# Default coach persona: lt_surge | shen | latika
APP_TRAINER_DEFAULT_PERSONA=lt_surge
