# Version control
.git
.gitignore

# Framework-generated caches (rebuilt by entrypoint with correct env/packages)
bootstrap/cache/packages.php
bootstrap/cache/services.php

# Vendor is built in stage 1 (composer install --no-dev); exclude entirely
# to prevent the host vendor (with dev deps) from overwriting it.
vendor/
compose.yaml
compose.override.yaml

# Dev tooling
node_modules
package-lock.json
yarn.lock
pnpm-lock.yaml
pint.json
phpstan.neon*

# Test artifacts
.phpunit.result.cache
coverage/

# Environment files — injected by Coolify as secrets
.env
.env.*
!.env.example

# Local docs and IDE config
.cursor
.idea
.vscode
*.md
!vendor/**/*.md

# Compiled assets (not applicable — API-only)
public/hot
public/storage
storage/*.key
