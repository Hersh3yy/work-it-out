parameters:
	ignoreErrors:
		-
			message: '#^Offset ''candidates'' on array\{is_limitation\: bool, body_area\: string\|null, candidates\: list\<string\>, severity\: string\|null, duration_days\: int\|null, started_days_ago\: int\|null, note\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Actions/Limitations/RecordLimitation.php

		-
			message: '#^Offset ''note'' on array\{is_limitation\: bool, body_area\: string\|null, candidates\: list\<string\>, severity\: string\|null, duration_days\: int\|null, started_days_ago\: int\|null, note\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Actions/Limitations/RecordLimitation.php

		-
			message: '#^Call to function is_array\(\) with null will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: app/Actions/SmartLog/AnswerOpenQuestion.php

		-
			message: '#^Offset ''pair'' on array\{field\: string, question\: string\} on left side of \?\? does not exist\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Actions/SmartLog/AnswerOpenQuestion.php

		-
			message: '#^Strict comparison using \=\=\= between \*NEVER\* and mixed will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: app/Actions/SmartLog/AnswerOpenQuestion.php

		-
			message: '#^Strict comparison using \=\=\= between Carbon\\CarbonImmutable\|null and false will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: app/Actions/SmartLog/RecordSmartLog.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$email\.$#'
			identifier: property.notFound
			count: 1
			path: app/Ai/Usage/UsageReport.php

		-
			message: '#^Using nullsafe property access "\?\-\>email" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Ai/Usage/UsageReport.php

		-
			message: '#^Using nullsafe property access "\?\-\>notes" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Coach/CoachContext.php

		-
			message: '#^Using nullsafe property access "\?\-\>notes" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Controllers/Api/OverviewController.php

		-
			message: '#^Cannot call method toDateString\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Http/Resources/BodyWeightLogResource.php

		-
			message: '#^Cannot call method toDateString\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Http/Resources/UserResource.php

		-
			message: '#^Cannot call method toIso8601String\(\) on string\.$#'
			identifier: method.nonObject
			count: 1
			path: app/Http/Resources/UserResource.php

		-
			message: '#^Comparison operation "\>" between 0 and 0 is always false\.$#'
			identifier: greater.alwaysFalse
			count: 1
			path: app/Interpretation/Lab/ClassifierLab.php

		-
			message: '#^Instanceof between Laravel\\Ai\\Responses\\Data\\TextUsage and Laravel\\Ai\\Responses\\Data\\TextUsage will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 2
			path: app/Listeners/RecordAiCall.php

		-
			message: '#^Cannot access property \$value on string\.$#'
			identifier: property.nonObject
			count: 2
			path: app/Profile/ProfileFacts.php

		-
			message: '#^Cannot call method toDateString\(\) on string\.$#'
			identifier: method.nonObject
			count: 3
			path: app/Profile/ProfileFacts.php

		-
			message: '#^Using nullsafe property access "\?\-\>notes" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Profile/UpdateProfile.php

		-
			message: '#^Using nullsafe property access "\?\-\>id" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: app/Providers/AppServiceProvider.php
