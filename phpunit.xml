<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <!-- force="true": the Docker app container exports .env as real env vars, which would
         otherwise win and point the suite at the dev MySQL database. Laravel reads $_SERVER
         before $_ENV, so each value is set in both. -->
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <!-- No real key or bot token reaches the suite; a test that needs an answer fakes it. -->
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="OPENAI_API_KEY" value="" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="DEEPSEEK_API_KEY" value="" force="true"/>
        <env name="OPENROUTER_API_KEY" value="" force="true"/>
        <env name="GROQ_API_KEY" value="" force="true"/>
        <env name="MISTRAL_API_KEY" value="" force="true"/>
        <env name="XAI_API_KEY" value="" force="true"/>
        <env name="TYPESAFE_API_KEY" value="" force="true"/>
        <env name="LAYA_API_KEY" value="" force="true"/>
        <env name="TELEGRAM_BOT_TOKEN" value="" force="true"/>
        <env name="AI_FALLBACKS" value="" force="true"/>
        <server name="GEMINI_API_KEY" value="" force="true"/>
        <server name="OPENAI_API_KEY" value="" force="true"/>
        <server name="ANTHROPIC_API_KEY" value="" force="true"/>
        <server name="DEEPSEEK_API_KEY" value="" force="true"/>
        <server name="OPENROUTER_API_KEY" value="" force="true"/>
        <server name="GROQ_API_KEY" value="" force="true"/>
        <server name="MISTRAL_API_KEY" value="" force="true"/>
        <server name="XAI_API_KEY" value="" force="true"/>
        <server name="TYPESAFE_API_KEY" value="" force="true"/>
        <server name="LAYA_API_KEY" value="" force="true"/>
        <server name="TELEGRAM_BOT_TOKEN" value="" force="true"/>
        <server name="AI_FALLBACKS" value="" force="true"/>
    </php>
</phpunit>
